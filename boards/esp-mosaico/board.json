{
    "name": "ESP-Mosaico",
    "version": 1,
    "description": "ESP-Mosaico is an expandable smart interaction development kit based on ESP32-S31. It targets magnetic expansion, motion sensing, square touch display, and edge multimedia scenarios.",
    "author": "Kristaps Jurkans",
    "mcu": "esp32-s31",
    "mcuAttrs": {
        "flashSize": "16",
        "psramSize": "16",
        "psramType": "octal"
    },
    "fqbn": "esp32:esp32:esp32s31",
    "width": 71.736,
    "height": 71.736,
    "pins": {
        // left module slot
        // https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32s31/esp-mosaico/user_guide.html#left-module-slot-h2-pins
        // top row - top -> bottom
        "55": {"x": 5.39, "y": 24.69, "target": "GPIO55"},
        "19": {"x": 5.39, "y": 27.23, "target": "GPIO19"},
        "18": {"x": 5.39, "y": 29.77, "target": "GPIO18"},
        "17": {"x": 5.39, "y": 32.31, "target": "GPIO17"},
        "16": {"x": 5.39, "y": 34.85, "target": "GPIO16"},
        "15": {"x": 5.39, "y": 37.39, "target": "GPIO15"},
        "USJ_DN": {"x": 5.39, "y": 39.93, "target": "GPIO33"},
        "USJ_DP": {"x": 5.39, "y": 42.47, "target": "GPIO34"},
        "VIN.1": {"x": 5.39, "y": 45.01, "target": "power(5)"},
        "3V3.1": {"x": 5.39, "y": 47.55, "target": "power(3.3)"},
        // bottom row - bottom -> top
        "GND.1": {"x": 2.85, "y": 47.55, "target": "GND"},
        "5V.1": {"x": 2.85, "y": 45.01, "target": "power(5)"},
        "0.1": {"x": 2.85, "y": 42.47, "target": "GPIO0"},
        "1.1": {"x": 2.85, "y": 39.93, "target": "GPIO1"},
        "4": {"x": 2.85, "y": 37.39, "target": "GPIO4"},
        "14": {"x": 2.85, "y": 34.85, "target": "GPIO14"},
        "12": {"x": 2.85, "y": 32.31, "target": "GPIO12"},
        "13": {"x": 2.85, "y": 29.77, "target": "GPIO13"},
        "48": {"x": 2.85, "y": 27.23, "target": "GPIO48"},
        "53": {"x": 2.85, "y": 24.69, "target": "GPIO53"},

        // right module slot
        // https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32s31/esp-mosaico/user_guide.html#right-module-slot-h1-pins
        // top row - top -> bottom
        "3V3.2": {"x": 66.35, "y": 24.69, "target": "power(3.3)"},
        "VIN.2": {"x": 66.35, "y": 27.23, "target": "power(5)"},
        "TX0": {"x": 66.35, "y": 29.77, "target": "GPIO58"},
        "RX0": {"x": 66.35, "y": 32.31, "target": "GPIO59"},
        "38": {"x": 66.35, "y": 34.85, "target": "GPIO38"},
        "40": {"x": 66.35, "y": 37.39, "target": "GPIO40"},
        "37": {"x": 66.35, "y": 39.93, "target": "GPIO37"},
        "54": {"x": 66.35, "y": 42.47, "target": "GPIO54"},
        "52": {"x": 66.35, "y": 45.01, "target": "GPIO52"},
        "49": {"x": 66.35, "y": 47.55, "target": "GPIO49"},
        // bottom row - bottom -> top
        "46": {"x": 68.89, "y": 47.55, "target": "GPIO46"},
        "47": {"x": 68.89, "y": 45.01, "target": "GPIO47"},
        "11": {"x": 68.89, "y": 42.47, "target": "GPIO11"},
        "10": {"x": 68.89, "y": 39.93, "target": "GPIO10"},
        "39": {"x": 68.89, "y": 37.39, "target": "GPIO39"},
        "5": {"x": 68.89, "y": 34.85, "target": "GPIO5"},
        "1.2": {"x": 68.89, "y": 32.31, "target": "GPIO1"},
        "0.2": {"x": 68.89, "y": 29.77, "target": "GPIO0"},
        "5V.2": {"x": 68.89, "y": 27.23, "target": "power(5)"},
        "GND.2": {"x": 68.89, "y": 24.69, "target": "GND"},

        "$gpio6": {"target": ["GPIO6", "touch1:INT"]},
        "$gpio44": {"target": ["GPIO44", "touch1:RST", "lcd1:RST"]},
        "$gpio43": {"target": ["GPIO43", "lcd1:TE"]},
        "$gpio36": {"target": ["GPIO36", "lcd1:D0"]},
        "$gpio50": {"target": ["GPIO50", "lcd1:CS"]},
        "$gpio42": {"target": ["GPIO42", "lcd1:CLK"]},
        "$gpio51": {"target": ["GPIO51", "lcd1:D1"]},
        "$gpio35": {"target": ["GPIO35", "lcd1:D2"]},
        "$gpio9": {"target": ["GPIO9", "lcd1:D3"]},
        "$gpio56": {"target": ["GPIO56", "touch1:SDA"]},
        "$gpio3": {"target": ["GPIO3", "touch1:SCL"]}
    },

    "displays": [
        {
            "id": "lcd1",
            "x": 14.118,
            "y": 14.118,
            "width": 43.50,
            "height": 43.50,
            "pixelWidth": 480,
            "pixelHeight": 480,
            "flipVertical": false,
            "chip": "co5300",
            "touch": {
                "id": "touch1",
                "chip": "cst9220"
            }
        }
    ],

    "leds": [
        {
            // charging led
            "id": "led1",
            "x": 35.7,
            "y": 64.2,
            "type": "0603",
            "color": "white",
            "pins": {
                "A": "3V3.1",
                "C": "GND.1"
            }
        }
    ]
}